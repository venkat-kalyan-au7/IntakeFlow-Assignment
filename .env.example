SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/intakeflow?serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
SPRING_DATASOURCE_USERNAME=intakeflow
SPRING_DATASOURCE_PASSWORD=replace-me
JWT_SECRET=replace-with-at-least-32-random-characters
APP_ALLOWED_ORIGINS=http://localhost:4200
APP_DEMO_MODE=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@intakeflow.app
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
APP_BOOTSTRAP_REQUESTER_EMAIL=requester@intakeflow.app
APP_BOOTSTRAP_REQUESTER_PASSWORD=replace-with-a-strong-unique-password
APP_BOOTSTRAP_REVIEWER_EMAIL=reviewer@intakeflow.app
APP_BOOTSTRAP_REVIEWER_PASSWORD=replace-with-a-strong-unique-password
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
JWT_TTL_MINUTES=480
DB_POOL_SIZE=8
